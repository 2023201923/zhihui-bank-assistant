/* 全局页面容器 */
page {
  background-color: #f7f1e6;
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  color: #1f2329;
}

.page-wrapper {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* 1. 顶部资产导航：上行身份+余额，下行操作，避免按钮把姓名挤没 */
.top-nav {
  background: #fffaf3;
  padding: 16rpx 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border-bottom: 1rpx solid #f0e2c8;
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
}

.nav-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-width: 0;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.nav-mark {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.nav-meta {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 2rpx;
  min-width: 0;
}

.nav-bank {
  font-size: 24rpx;
  color: #86909c;
  line-height: 1.2;
  white-space: nowrap;
}

.nav-user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2329;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
}

.nav-logout {
  font-size: 26rpx;
  color: #a97820;
  padding: 8rpx 16rpx;
  border: 1rpx solid #e7d3ae;
  border-radius: 20rpx;
  background: #fff;
  flex-shrink: 0;
}

.asset-badge {
  background-color: #fff4df;
  padding: 10rpx 18rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  flex-shrink: 0;
}

.asset-label {
  font-size: 24rpx;
  color: #86909c;
}

.asset-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #c45c26;
}

/* 2. 聊天区域 */
.dialogue-scroll {
  flex: 1;
  overflow: hidden;
}

.dialogue-list {
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.chat-row {
  display: flex;
  width: 100%;
  box-sizing: border-box;
}

.user-row {
  justify-content: flex-end;
}

.ai-row {
  justify-content: flex-start;
  align-items: flex-start;
}

/* 头像设计 */
.user-avatar-wrap, .ai-avatar-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.user-avatar-wrap {
  background-color: #fff1dc;
  color: #a97820;
  margin-left: 16rpx;
}

.ai-avatar-wrap {
  background: transparent;
  margin-right: 16rpx;
  overflow: hidden;
  border: none;
  padding: 0;
}

.avatar-logo {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
}

.avatar-text {
  font-size: 26rpx;
  font-weight: 600;
}

/* 气泡样式 */
.msg-content {
  max-width: 82%;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
}

.msg-bubble {
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  flex-shrink: 0;
}

.user-bubble {
  max-width: 75%;
  background: linear-gradient(135deg, #e0b15a 0%, #c45c26 100%);
  color: #ffffff;
  border-top-right-radius: 4rpx;
  box-shadow: 0 4rpx 12rpx rgba(166, 94, 28, 0.22);
}

.ai-bubble {
  background-color: #ffffff;
  color: #1d2129;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

/* 2026-10-23 新增：等待回复时的内联「正在输入」气泡，替代全屏阻塞 loading */
.typing-bubble {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 116rpx;
  padding: 24rpx 28rpx;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c9a227;
  opacity: 0.3;
  animation: typing-blink 1.2s infinite ease-in-out;
}

.typing-dot:nth-child(2) {
  animation-delay: 0.18s;
}

.typing-dot:nth-child(3) {
  animation-delay: 0.36s;
}

@keyframes typing-blink {
  0%,
  60%,
  100% {
    opacity: 0.28;
    transform: translateY(0);
  }
  30% {
    opacity: 1;
    transform: translateY(-4rpx);
  }
}

/* 2026-10-23 新增：失败后一键重发 */
.retry-row {
  display: flex;
  margin-top: 12rpx;
}

.retry-btn {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e0b15a;
  background: #fffaf3;
  color: #a97820;
  font-size: 24rpx;
}

/* 3. 卡片容器基准 */
.card-box {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #f0f1f2;
  overflow: hidden;
}

/* 菜单导航卡 */
.menu-card {
  padding: 28rpx;
  width: 580rpx;
  box-sizing: border-box;
}

.menu-intro {
  margin-bottom: 24rpx;
}

.intro-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1d2129;
  margin-bottom: 8rpx;
}

.intro-desc {
  display: block;
  font-size: 24rpx;
  color: #86909c;
  line-height: 1.5;
}

.menu-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.action-chip {
  background: #fffaf3;
  border: 1rpx solid #f0e2c8;
  border-radius: 12rpx;
  padding: 18rpx 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  transition: all 0.2s ease;
}

.chip-hover {
  background-color: #fff4e0;
  border-color: #e0b15a;
}

.chip-icon {
  /* 2026-10-23：单字图标替代 emoji —— 各机型渲染一致，也更贴合银行的克制风格 */
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.chip-icon--transfer {
  background: #fdeee4;
  color: #b8501f;
}

.chip-icon--bill {
  background: #eef3fb;
  color: #2f5d9e;
}

.chip-icon--wealth {
  background: #fdf3dd;
  color: #a97820;
}

.chip-icon--profile {
  background: #eef6ef;
  color: #2f7a4d;
}

.chip-icon--card {
  background: #f0eefb;
  color: #5a4fa3;
}

.chip-icon--sub {
  background: #edf5f6;
  color: #2b6f75;
}

.chip-icon--cross {
  background: #fdeef2;
  color: #a63a5c;
}

.chip-icon--safety {
  background: #f7efe2;
  color: #8a5a1e;
}

.chip-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #272e3b;
}

.info-dot {
  background-color: #c9a227;
}

.info-card {
  width: 560rpx;
  padding: 28rpx 32rpx;
  box-sizing: border-box;
}

.card-intro {
  display: block;
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.55;
  margin: -8rpx 0 20rpx;
}

.asset-item-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.asset-item {
  background: #fffaf3;
  border: 1rpx solid #f0e2c8;
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
}

.asset-item-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.asset-item-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1d2129;
}

.asset-item-kicker {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #86909c;
}

.asset-item-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #c45c26;
  flex-shrink: 0;
}

.asset-item-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  gap: 12rpx;
}

.asset-item-meta {
  font-size: 24rpx;
  color: #4e5969;
}

.asset-item-badge {
  font-size: 24rpx;
  color: #c45c26;
  background: #fff4df;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.pay-source {
  margin: 0 0 24rpx;
}

.pay-source-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1d2129;
  margin-bottom: 12rpx;
}

.pay-source-item {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #f0e2c8;
  border-radius: 14rpx;
  background: #fffaf3;
}

.pay-source-item.selected {
  border-color: #c45c26;
  background: #fff4df;
}

.pay-source-item.disabled {
  opacity: 0.55;
}

.pay-source-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.pay-source-id {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #86909c;
}

.pay-source-cap {
  display: block;
  font-size: 24rpx;
  color: #4e3b24;
  text-align: right;
}

.pay-source-reason {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #86909c;
  text-align: right;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f2f3f5;
}

.info-row-right {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.info-percent {
  font-size: 24rpx;
  color: #c45c26;
}

.highlight-box {
  margin-top: 20rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.highlight-box.muted {
  background: #ffffff;
  border: 1rpx dashed #e5e6eb;
}

.highlight-title {
  display: block;
  font-size: 24rpx;
  color: #86909c;
  margin-bottom: 8rpx;
}

.highlight-line {
  display: block;
  font-size: 26rpx;
  color: #4e5969;
  line-height: 1.5;
  margin-bottom: 6rpx;
}

/* 转账核对单卡片 */
.transfer-card {
  width: 560rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.card-title-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  background-color: #ff7d00;
  border-radius: 7rpx;
}

.card-title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #1d2129;
  line-height: 1.4;
}

.card-tag {
  flex-shrink: 0;
  margin-left: 12rpx;
  white-space: nowrap;
  font-size: 24rpx;
  background: #fff7e8;
  color: #ff7d00;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1rpx solid #ffe4ba;
}

.amount-hero {
  text-align: center;
  margin: 16rpx 0 28rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  color: #f53f3f;
}

.currency {
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 6rpx;
}

.amount-number {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.data-table {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 28rpx;
}

.data-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 10rpx 0;
  font-size: 26rpx;
}

.data-key {
  flex-shrink: 0;
  white-space: nowrap;
  margin-right: 24rpx;
  color: #86909c;
}

.data-val {
  flex: 1;
  min-width: 0;
  color: #1d2129;
  text-align: right;
  line-height: 1.5;
  word-break: break-word;
}

.data-row--note {
  flex-direction: column;
  gap: 8rpx;
}

.data-row--note .data-key {
  margin-right: 0;
}

.data-row--note .data-val {
  text-align: left;
}

.data-val.bold {
  font-weight: 600;
}

/* 按钮样式覆写（清除微信原生 Button 的宽边框和巨大高度） */
.card-btn-box {
  width: 100%;
}

.card-btn-row {
  display: flex;
  gap: 16rpx;
}

.card-btn-row button.custom-primary-btn,
.card-btn-row button.custom-secondary-btn {
  flex: 1;
}

button.custom-secondary-btn {
  margin: 0 !important;
  width: 100% !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  padding: 0 !important;
  background: #f2f3f5 !important;
  color: #4e5969 !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border-radius: 12rpx !important;
  border: 1rpx solid #e5e6eb !important;
}

button.custom-secondary-btn::after {
  border: none !important;
}

button.custom-secondary-btn.is-disabled {
  background: #f7f8fa !important;
  color: #c9cdd4 !important;
}

button.custom-primary-btn {
  margin: 0 !important;
  width: 100% !important;
  height: 80rpx !important;
  line-height: 80rpx !important;
  padding: 0 !important;
  background: linear-gradient(135deg, #e0b15a 0%, #c45c26 100%) !important;
  color: #ffffff !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border-radius: 12rpx !important;
  border: none !important;
  box-shadow: 0 4rpx 12rpx rgba(166, 94, 28, 0.25);
}

button.custom-primary-btn::after {
  border: none !important;
}

button.custom-primary-btn.is-disabled {
  background: #c9cdd4 !important;
  color: #ffffff !important;
  box-shadow: none !important;
}

/* 4. 底部输入控制条 */
.bottom-bar {
  background: #fffaf3;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0e2c8;
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-control {
  flex: 1;
  height: 76rpx;
  background: #f8f1e4;
  border-radius: 38rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #1d2129;
}

.input-placeholder {
  color: #c9cdd4;
  font-size: 26rpx;
}

button.send-action-btn {
  margin: 0 !important;
  width: 130rpx !important;
  height: 76rpx !important;
  line-height: 76rpx !important;
  padding: 0 !important;
  background: linear-gradient(135deg, #e0b15a 0%, #c45c26 100%) !important;
  color: #ffffff !important;
  font-size: 26rpx !important;
  font-weight: 600 !important;
  border-radius: 38rpx !important;
  border: none !important;
}

button.send-action-btn::after {
  border: none !important;
}

/* 2026-10-23 新增：发送中按钮置灰，配合内联 loading 防重复提交 */
button.send-action-btn.is-sending {
  background: #e6d8c3 !important;
  color: #8d7f6d !important;
}

/* 理财申购底部面板 */
.purchase-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(43, 28, 10, 0.45);
  z-index: 1000;
}

.purchase-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1001;
  background: #fffaf3;
  border-radius: 28rpx 28rpx 0 0;
  padding: 12rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(107, 74, 22, 0.12);
  transform: translateY(110%);
  transition: transform 0.25s ease;
}

.purchase-sheet.show {
  transform: translateY(0);
  max-height: 86vh;
  overflow-y: auto;
}

.purchase-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #e8d4b0;
  margin: 8rpx auto 20rpx;
}

.purchase-sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.purchase-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #6b4a16;
}

.purchase-sheet-close {
  font-size: 26rpx;
  color: #a97820;
  padding: 8rpx 0 8rpx 16rpx;
}

.purchase-product-card {
  background: linear-gradient(135deg, #fff4df 0%, #ffe8c7 100%);
  border: 1rpx solid #f0d7a8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.purchase-product-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #4e3b24;
}

.purchase-product-min {
  font-size: 24rpx;
  color: #c45c26;
}

.purchase-field-label {
  display: block;
  font-size: 26rpx;
  color: #8c6d3f;
  margin-bottom: 12rpx;
}

.purchase-input-wrap {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 2rpx solid #f0d7a8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
}

.purchase-input-wrap.has-error {
  border-color: #f53f3f;
  background: #fff7f7;
}

.purchase-currency {
  font-size: 36rpx;
  font-weight: 700;
  color: #c45c26;
  margin-right: 12rpx;
}

.purchase-input {
  flex: 1;
  height: 88rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #2b1c0a;
}

.purchase-placeholder {
  font-size: 28rpx;
  color: #d4c4a8;
  font-weight: 400;
}

.purchase-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #a97820;
}

.purchase-error {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #f53f3f;
  font-weight: 500;
}

.purchase-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

button.purchase-cancel-btn {
  margin: 0 !important;
  flex: 1;
  height: 84rpx !important;
  line-height: 84rpx !important;
  padding: 0 !important;
  background: #f8f1e4 !important;
  color: #6b4a16 !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border-radius: 42rpx !important;
  border: 1rpx solid #e8d4b0 !important;
}

button.purchase-cancel-btn::after {
  border: none !important;
}

button.purchase-submit-btn {
  margin: 0 !important;
  flex: 1.4;
  height: 84rpx !important;
  line-height: 84rpx !important;
  padding: 0 !important;
  background: linear-gradient(135deg, #e0b15a 0%, #c45c26 100%) !important;
  color: #ffffff !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
  border-radius: 42rpx !important;
  border: none !important;
}

button.purchase-submit-btn.disabled {
  background: #e8dcc8 !important;
  color: #ffffff !important;
}

button.purchase-submit-btn::after {
  border: none !important;
}

/* 金选理财货架 */
.wealth-shelf-container {
  width: 520rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  box-sizing: border-box;
